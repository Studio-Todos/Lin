// std/control.lin
// Standard control flow logic using strict parallel dataflow structures.

either: mlir-op [
    inputs:  [cond [i32!] t [i32!] f [i32!]]
    outputs: [res [i32!]]
] {
    %c0 = arith.constant 0 : i32
    %cond_bool = arith.cmpi ne, %cond, %c0 : i32
    %res = arith.select %cond_bool, %t, %f : i32
}
