// std/math.lin
// Standard math library for Lin.
// Uses i64/i32 bitcasts to bypass compiler type restrictions on wires.

// --- Integer 64-bit ---

add64: mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %res = arith.addi %a, %b : i64
}
sub64: mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %res = arith.subi %a, %b : i64
}
mul64: mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %res = arith.muli %a, %b : i64
}
divs64: mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %res = arith.divsi %a, %b : i64
}
divu64: mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %res = arith.divui %a, %b : i64
}
rems64: mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %res = arith.remsi %a, %b : i64
}
remu64: mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %res = arith.remui %a, %b : i64
}

and64: mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %res = arith.andi %a, %b : i64
}
or64: mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %res = arith.ori %a, %b : i64
}
xor64: mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %res = arith.xori %a, %b : i64
}
shl64: mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %res = arith.shli %a, %b : i64
}
ashr64: mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %res = arith.shrsi %a, %b : i64
}
lshr64: mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %res = arith.shrui %a, %b : i64
}

min64: mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %c = arith.cmpi slt, %a, %b : i64
    %res = arith.select %c, %a, %b : i64
}
max64: mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %c = arith.cmpi sgt, %a, %b : i64
    %res = arith.select %c, %a, %b : i64
}

// --- Integer 32-bit ---

add32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %res = arith.addi %a, %b : i32
}
sub32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %res = arith.subi %a, %b : i32
}
mul32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %res = arith.muli %a, %b : i32
}
divs32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %res = arith.divsi %a, %b : i32
}
divu32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %res = arith.divui %a, %b : i32
}
rems32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %res = arith.remsi %a, %b : i32
}
remu32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %res = arith.remui %a, %b : i32
}

// Bitwise XOR (i32)
xor32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %res = arith.xori %a, %b : i32
}

// Absolute value (i32)
abs32: mlir-op [ inputs: [a [i32!]] outputs: [res [i32!]] ] {
    %c0 = arith.constant 0 : i32
    %neg = arith.subi %c0, %a : i32
    %cmp = arith.cmpi slt, %a, %c0 : i32
    %res = arith.select %cmp, %neg, %a : i32
}

// Negation (i32)
neg32: mlir-op [ inputs: [a [i32!]] outputs: [res [i32!]] ] {
    %c0 = arith.constant 0 : i32
    %res = arith.subi %c0, %a : i32
}

// Bitwise operations (i32)
and32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %res = arith.andi %a, %b : i32
}
or32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %res = arith.ori %a, %b : i32
}
shl32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %res = arith.shli %a, %b : i32
}
ashr32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %res = arith.shrsi %a, %b : i32
}
lshr32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %res = arith.shrui %a, %b : i32
}

// Min / Max (i32)
min32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %c = arith.cmpi slt, %a, %b : i32
    %res = arith.select %c, %a, %b : i32
}
max32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %c = arith.cmpi sgt, %a, %b : i32
    %res = arith.select %c, %a, %b : i32
}

// Comparisons (i32)
eq32:  mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %c = arith.cmpi eq, %a, %b : i32
    %zero = arith.constant 0 : i32
    %one = arith.constant 1 : i32
    %res = arith.select %c, %one, %zero : i32
}
ne32:  mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %c = arith.cmpi ne, %a, %b : i32
    %zero = arith.constant 0 : i32
    %one = arith.constant 1 : i32
    %res = arith.select %c, %one, %zero : i32
}
slt32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %c = arith.cmpi slt, %a, %b : i32
    %zero = arith.constant 0 : i32
    %one = arith.constant 1 : i32
    %res = arith.select %c, %one, %zero : i32
}
sgt32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %c = arith.cmpi sgt, %a, %b : i32
    %zero = arith.constant 0 : i32
    %one = arith.constant 1 : i32
    %res = arith.select %c, %one, %zero : i32
}
sle32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %c = arith.cmpi sle, %a, %b : i32
    %zero = arith.constant 0 : i32
    %one = arith.constant 1 : i32
    %res = arith.select %c, %one, %zero : i32
}
sge32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %c = arith.cmpi sge, %a, %b : i32
    %zero = arith.constant 0 : i32
    %one = arith.constant 1 : i32
    %res = arith.select %c, %one, %zero : i32
}

// Float comparisons (f32 -> i32)
feq32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %af = arith.bitcast %a : i32 to f32
    %bf = arith.bitcast %b : i32 to f32
    %c = arith.cmpf oeq, %af, %bf : f32
    %one = arith.constant 1 : i32
    %zero = arith.constant 0 : i32
    %res = arith.select %c, %one, %zero : i32
}
fneq32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %af = arith.bitcast %a : i32 to f32
    %bf = arith.bitcast %b : i32 to f32
    %c = arith.cmpf une, %af, %bf : f32
    %one = arith.constant 1 : i32
    %zero = arith.constant 0 : i32
    %res = arith.select %c, %one, %zero : i32
}
flt32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %af = arith.bitcast %a : i32 to f32
    %bf = arith.bitcast %b : i32 to f32
    %c = arith.cmpf olt, %af, %bf : f32
    %one = arith.constant 1 : i32
    %zero = arith.constant 0 : i32
    %res = arith.select %c, %one, %zero : i32
}
fgt32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %af = arith.bitcast %a : i32 to f32
    %bf = arith.bitcast %b : i32 to f32
    %c = arith.cmpf ogt, %af, %bf : f32
    %one = arith.constant 1 : i32
    %zero = arith.constant 0 : i32
    %res = arith.select %c, %one, %zero : i32
}
fle32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %af = arith.bitcast %a : i32 to f32
    %bf = arith.bitcast %b : i32 to f32
    %c = arith.cmpf ole, %af, %bf : f32
    %one = arith.constant 1 : i32
    %zero = arith.constant 0 : i32
    %res = arith.select %c, %one, %zero : i32
}
fge32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %af = arith.bitcast %a : i32 to f32
    %bf = arith.bitcast %b : i32 to f32
    %c = arith.cmpf oge, %af, %bf : f32
    %one = arith.constant 1 : i32
    %zero = arith.constant 0 : i32
    %res = arith.select %c, %one, %zero : i32
}

// Absolute value (i64)
abs64: mlir-op [ inputs: [a [i64!]] outputs: [res [i64!]] ] {
    %c0 = arith.constant 0 : i64
    %neg = arith.subi %c0, %a : i64
    %cmp = arith.cmpi slt, %a, %c0 : i64
    %res = arith.select %cmp, %neg, %a : i64
}

// Negation (i64)
neg64: mlir-op [ inputs: [a [i64!]] outputs: [res [i64!]] ] {
    %c0 = arith.constant 0 : i64
    %res = arith.subi %c0, %a : i64
}

// --- Floating Point 64-bit ---

fadd64: mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %af = arith.bitcast %a : i64 to f64
    %bf = arith.bitcast %b : i64 to f64
    %rf = arith.addf %af, %bf : f64
    %res = arith.bitcast %rf : f64 to i64
}
fsub64: mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %af = arith.bitcast %a : i64 to f64
    %bf = arith.bitcast %b : i64 to f64
    %rf = arith.subf %af, %bf : f64
    %res = arith.bitcast %rf : f64 to i64
}
fmul64: mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %af = arith.bitcast %a : i64 to f64
    %bf = arith.bitcast %b : i64 to f64
    %rf = arith.mulf %af, %bf : f64
    %res = arith.bitcast %rf : f64 to i64
}
fdiv64: mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %af = arith.bitcast %a : i64 to f64
    %bf = arith.bitcast %b : i64 to f64
    %rf = arith.divf %af, %bf : f64
    %res = arith.bitcast %rf : f64 to i64
}
frem64: mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %af = arith.bitcast %a : i64 to f64
    %bf = arith.bitcast %b : i64 to f64
    %rf = arith.remf %af, %bf : f64
    %res = arith.bitcast %rf : f64 to i64
}

fmin64: mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %af = arith.bitcast %a : i64 to f64
    %bf = arith.bitcast %b : i64 to f64
    %c = arith.cmpf olt, %af, %bf : f64
    %rf = arith.select %c, %af, %bf : f64
    %res = arith.bitcast %rf : f64 to i64
}
fmax64: mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %af = arith.bitcast %a : i64 to f64
    %bf = arith.bitcast %b : i64 to f64
    %c = arith.cmpf ogt, %af, %bf : f64
    %rf = arith.select %c, %af, %bf : f64
    %res = arith.bitcast %rf : f64 to i64
}
fsqrt64: mlir-op [ inputs: [a [i64!]] outputs: [res [i64!]] ] {
    %af = arith.bitcast %a : i64 to f64
    %rf = llvm.intr.sqrt(%af) : (f64) -> f64
    %res = arith.bitcast %rf : f64 to i64
}
fabs64: mlir-op [ inputs: [a [i64!]] outputs: [res [i64!]] ] {
    %af = arith.bitcast %a : i64 to f64
    %rf = llvm.intr.fabs(%af) : (f64) -> f64
    %res = arith.bitcast %rf : f64 to i64
}
fneg64: mlir-op [ inputs: [a [i64!]] outputs: [res [i64!]] ] {
    %af = arith.bitcast %a : i64 to f64
    %c0 = arith.constant 0.0 : f64
    %rf = arith.subf %c0, %af : f64
    %res = arith.bitcast %rf : f64 to i64
}

// Transcendentals 64-bit

// --- Floating Point 32-bit ---

fadd32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %af = arith.bitcast %a : i32 to f32
    %bf = arith.bitcast %b : i32 to f32
    %rf = arith.addf %af, %bf : f32
    %res = arith.bitcast %rf : f32 to i32
}
