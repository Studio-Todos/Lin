    %af = arith.bitcast %a : i32 to f32
    %rf = llvm.intr.sqrt(%af) : (f32) -> f32
    %res = arith.bitcast %rf : f32 to i32
}
fmin32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %af = arith.bitcast %a : i32 to f32
    %bf = arith.bitcast %b : i32 to f32
    %c = arith.cmpf olt, %af, %bf : f32
    %rf = arith.select %c, %af, %bf : f32
    %res = arith.bitcast %rf : f32 to i32
}
fmax32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %af = arith.bitcast %a : i32 to f32
    %bf = arith.bitcast %b : i32 to f32
    %c = arith.cmpf ogt, %af, %bf : f32
    %rf = arith.select %c, %af, %bf : f32
    %res = arith.bitcast %rf : f32 to i32
