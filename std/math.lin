// --- Float Comparisons 32-bit ---

feq32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %af = arith.bitcast %a : i32 to f32
    %bf = arith.bitcast %b : i32 to f32
    %c = arith.cmpf oeq, %af, %bf : f32
    %one = arith.constant 1 : i32
    %zero = arith.constant 0 : i32
    %res = arith.select %c, %one, %zero : i32
}
fneq32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %af = arith.bitcast %a : i32 to f32
    %bf = arith.bitcast %b : i32 to f32
    %c = arith.cmpf une, %af, %bf : f32
    %one = arith.constant 1 : i32
    %zero = arith.constant 0 : i32
    %res = arith.select %c, %one, %zero : i32
}
flt32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %af = arith.bitcast %a : i32 to f32
    %bf = arith.bitcast %b : i32 to f32
    %c = arith.cmpf olt, %af, %bf : f32
    %one = arith.constant 1 : i32
    %zero = arith.constant 0 : i32
    %res = arith.select %c, %one, %zero : i32
}
fgt32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %af = arith.bitcast %a : i32 to f32
    %bf = arith.bitcast %b : i32 to f32
    %c = arith.cmpf ogt, %af, %bf : f32
    %one = arith.constant 1 : i32
    %zero = arith.constant 0 : i32
    %res = arith.select %c, %one, %zero : i32
}
fle32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %af = arith.bitcast %a : i32 to f32
    %bf = arith.bitcast %b : i32 to f32
    %c = arith.cmpf ole, %af, %bf : f32
    %one = arith.constant 1 : i32
    %zero = arith.constant 0 : i32
    %res = arith.select %c, %one, %zero : i32
}
fge32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %af = arith.bitcast %a : i32 to f32
    %bf = arith.bitcast %b : i32 to f32
    %c = arith.cmpf oge, %af, %bf : f32
    %one = arith.constant 1 : i32
    %zero = arith.constant 0 : i32
    %res = arith.select %c, %one, %zero : i32
}

// --- Comparisons 64-bit ---

eq64:  mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %c = arith.cmpi eq, %a, %b : i64
    %zero = arith.constant 0 : i32
    %one = arith.constant 1 : i32
    %res_32 = arith.select %c, %one, %zero : i32
    %res = arith.extui %res_32 : i32 to i64
}
ne64:  mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %c = arith.cmpi ne, %a, %b : i64
    %zero = arith.constant 0 : i32
    %one = arith.constant 1 : i32
    %res_32 = arith.select %c, %one, %zero : i32
    %res = arith.extui %res_32 : i32 to i64
}
slt64: mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %c = arith.cmpi slt, %a, %b : i64
    %zero = arith.constant 0 : i32
    %one = arith.constant 1 : i32
    %res_32 = arith.select %c, %one, %zero : i32
    %res = arith.extui %res_32 : i32 to i64
}
sgt64: mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %c = arith.cmpi sgt, %a, %b : i64
    %zero = arith.constant 0 : i32
    %one = arith.constant 1 : i32
    %res_32 = arith.select %c, %one, %zero : i32
    %res = arith.extui %res_32 : i32 to i64
}
sle64: mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %c = arith.cmpi sle, %a, %b : i64
    %zero = arith.constant 0 : i32
    %one = arith.constant 1 : i32
    %res_32 = arith.select %c, %one, %zero : i32
    %res = arith.extui %res_32 : i32 to i64
}
sge64: mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %c = arith.cmpi sge, %a, %b : i64
    %zero = arith.constant 0 : i32
    %one = arith.constant 1 : i32
    %res_32 = arith.select %c, %one, %zero : i32
    %res = arith.extui %res_32 : i32 to i64
}

// --- Float Comparisons 64-bit ---

feq64: mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %af = arith.bitcast %a : i64 to f64
    %bf = arith.bitcast %b : i64 to f64
    %c = arith.cmpf oeq, %af, %bf : f64
    %one = arith.constant 1 : i32
    %zero = arith.constant 0 : i32
    %res_32 = arith.select %c, %one, %zero : i32
    %res = arith.extui %res_32 : i32 to i64
}
fneq64: mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %af = arith.bitcast %a : i64 to f64
    %bf = arith.bitcast %b : i64 to f64
    %c = arith.cmpf une, %af, %bf : f64
    %one = arith.constant 1 : i32
    %zero = arith.constant 0 : i32
    %res_32 = arith.select %c, %one, %zero : i32
    %res = arith.extui %res_32 : i32 to i64
}
flt64: mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %af = arith.bitcast %a : i64 to f64
    %bf = arith.bitcast %b : i64 to f64
    %c = arith.cmpf olt, %af, %bf : f64
    %one = arith.constant 1 : i32
    %zero = arith.constant 0 : i32
    %res_32 = arith.select %c, %one, %zero : i32
    %res = arith.extui %res_32 : i32 to i64
}
fgt64: mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %af = arith.bitcast %a : i64 to f64
    %bf = arith.bitcast %b : i64 to f64
    %c = arith.cmpf ogt, %af, %bf : f64
    %one = arith.constant 1 : i32
    %zero = arith.constant 0 : i32
    %res_32 = arith.select %c, %one, %zero : i32
    %res = arith.extui %res_32 : i32 to i64
}
fle64: mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %af = arith.bitcast %a : i64 to f64
    %bf = arith.bitcast %b : i64 to f64
    %c = arith.cmpf ole, %af, %bf : f64
    %one = arith.constant 1 : i32
    %zero = arith.constant 0 : i32
    %res_32 = arith.select %c, %one, %zero : i32
    %res = arith.extui %res_32 : i32 to i64
}
fge64: mlir-op [ inputs: [a [i64!] b [i64!]] outputs: [res [i64!]] ] {
    %af = arith.bitcast %a : i64 to f64
    %bf = arith.bitcast %b : i64 to f64
    %c = arith.cmpf oge, %af, %bf : f64
    %one = arith.constant 1 : i32
    %zero = arith.constant 0 : i32
    %res_32 = arith.select %c, %one, %zero : i32
    %res = arith.extui %res_32 : i32 to i64
}

// --- Constants ---

pi: func [return: [i64!]] [ (fadd64 0 0) ] // Placeholder for now, real pi needs dummy input mlir-op
e:  func [return: [i64!]] [ (fadd64 0 0) ] // Placeholder for now

// --- Integer 32-bit Comparisons ---

eq32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %c = arith.cmpi eq, %a, %b : i32
    %zero = arith.constant 0 : i32
    %one = arith.constant 1 : i32
    %res = arith.select %c, %one, %zero : i32
}
ne32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %c = arith.cmpi ne, %a, %b : i32
    %zero = arith.constant 0 : i32
    %one = arith.constant 1 : i32
    %res = arith.select %c, %one, %zero : i32
}
slt32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %c = arith.cmpi slt, %a, %b : i32
    %zero = arith.constant 0 : i32
    %one = arith.constant 1 : i32
    %res = arith.select %c, %one, %zero : i32
}
sgt32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %c = arith.cmpi sgt, %a, %b : i32
    %zero = arith.constant 0 : i32
    %one = arith.constant 1 : i32
    %res = arith.select %c, %one, %zero : i32
}
sle32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %c = arith.cmpi sle, %a, %b : i32
    %zero = arith.constant 0 : i32
    %one = arith.constant 1 : i32
    %res = arith.select %c, %one, %zero : i32
}
sge32: mlir-op [ inputs: [a [i32!] b [i32!]] outputs: [res [i32!]] ] {
    %c = arith.cmpi sge, %a, %b : i32
    %zero = arith.constant 0 : i32
    %one = arith.constant 1 : i32
    %res = arith.select %c, %one, %zero : i32
}

// --- i32 arithmetic convenience aliases ---
add: func [a [i32!] b [i32!] return: [i32!]] [(add32 a b)]
sub: func [a [i32!] b [i32!] return: [i32!]] [(sub32 a b)]
mul: func [a [i32!] b [i32!] return: [i32!]] [(mul32 a b)]
div: func [a [i32!] b [i32!] return: [i32!]] [(divs32 a b)]
rem: func [a [i32!] b [i32!] return: [i32!]] [(rems32 a b)]

// --- i64 arithmetic convenience aliases (signed division/remainder) ---
div64: func [a [i64!] b [i64!] return: [i64!]] [(divs64 a b)]
rem64: func [a [i64!] b [i64!] return: [i64!]] [(rems64 a b)]

// --- integer comparison convenience aliases (64-bit dispatch handles both i32 and i64 ranges) ---
eq:  func [a [i64!] b [i64!] return: [i64!]] [(eq64 a b)]
ne:  func [a [i64!] b [i64!] return: [i64!]] [(ne64 a b)]
neq: func [a [i64!] b [i64!] return: [i64!]] [(ne64 a b)]
lt:  func [a [i64!] b [i64!] return: [i64!]] [(slt64 a b)]
gt:  func [a [i64!] b [i64!] return: [i64!]] [(sgt64 a b)]
le:  func [a [i64!] b [i64!] return: [i64!]] [(sle64 a b)]
ge:  func [a [i64!] b [i64!] return: [i64!]] [(sge64 a b)]

// --- f64 arithmetic convenience aliases ---
fadd: func [a [i64!] b [i64!] return: [i64!]] [(fadd64 a b)]
fsub: func [a [i64!] b [i64!] return: [i64!]] [(fsub64 a b)]
fmul: func [a [i64!] b [i64!] return: [i64!]] [(fmul64 a b)]
fdiv: func [a [i64!] b [i64!] return: [i64!]] [(fdiv64 a b)]
