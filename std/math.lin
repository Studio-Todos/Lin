fabs32: mlir-op [ inputs: [a [i32!]] outputs: [res [i32!]] ] {
    %af = arith.bitcast %a : i32 to f32
    %rf = llvm.intr.fabs(%af) : (f32) -> f32
    %res = arith.bitcast %rf : f32 to i32
}
fneg32: mlir-op [ inputs: [a [i32!]] outputs: [res [i32!]] ] {
    %af = arith.bitcast %a : i32 to f32
    %c0 = arith.constant 0.0 : f32
    %rf = arith.subf %c0, %af : f32
    %res = arith.bitcast %rf : f32 to i32
