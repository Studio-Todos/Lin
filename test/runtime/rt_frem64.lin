// RUN: %linc build %s -o %t && %t | FileCheck %s
// Runtime correctness: f64 remainder (frem64) — 5.0 % 2.0 == 1.0
import "std/types.lin"
import "std/math.lin"
import "std/io.lin"

main: func [return: [i32!]] [
    state: 0
    state: (print_f64 state (frem64 5.0 2.0))
    state: (print_char state 10)
    0
]
// CHECK: 1.0
