// RUN: %linc build %s -o %t && %t | FileCheck %s
// Runtime regression: a `either` used as a STATEMENT whose branches thread
// `state` through print ops must not crash (previously OOB-SIGSEGV'd) and the
// state thread must continue correctly past the either to a definitive print.
// NOTE: the chosen branch bodies are lowered as deferred closures; their
// in-branch side-effect prints are not yet observed at runtime (see exec_control_flow),
// so this asserts the stable no-crash + state-threading behavior.
import "std/types.lin"
import "std/math.lin"
import "std/io.lin"

main: func [return: [i32!]] [
    state: 0
    either (lt 10 5) [ state: (print_i32 state 1) ][ state: (print_i32 state 0) ]
    either (lt 3 10) [ state: (print_i32 state 1) ][ state: (print_i32 state 0) ]
    state: (print_i32 state 77)
    state: (print_char state 10)
    0
]
// CHECK: 77
