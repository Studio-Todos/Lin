// RUN: %linc build %s -o %t && %t | FileCheck %s
import "std/types.lin"
import "std/math.lin"
import "std/io.lin"

main: func [return: [i32!]] [
    state: 0
    state: (print_i32 state 65)
    state: (print_char state 10)
    state: (print_char state 65)
    state: (print_char state 10)
    state: (print_str state "hello")
    state: (print_char state 10)
    // CHECK: 65
    // CHECK: A
    // CHECK: hello
    0
]