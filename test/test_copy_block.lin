// RUN: %linc build %s -o %t && %t
// Runtime test: copy block data lowering converts AST_BLOCK_DATA to pair chains
import "std/types.lin"
import "std/io.lin"
import "std/math.lin"

test_copy: func [return: [i32!]] [
    // copy [42 99] creates pair chain: (pair 42 (pair 99 era))
    v: copy [42 99]

    // Access elements via field access
    first: (v/1)
    second: ((v/2)/2)

    (print_i32 0 first)
    (print_i32 0 second)
    0
]

(test_copy 0)