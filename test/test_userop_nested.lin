// RUN: %linc build %s -o %t && %t
// Test nested user-op calls (result of one op fed as arg to another).
import "std/math.lin"
import "std/io.lin"

test_nested: func [
    argc [i32!]
    return: [i32!]
][
    // (add 1 (mul 2 3)) = 7
    either (neq (add 1 (mul 2 3)) 7) [1][
    // (sub (mul 5 5) (add 3 2)) = 25 - 5 = 20
    either (neq (sub (mul 5 5) (add 3 2)) 20) [2][
    // (div (mul 6 7) (add 2 1)) = 42 / 3 = 14
    either (neq (div (mul 6 7) (add 2 1)) 14) [3][
    // (rem (add 10 5) (sub 8 5)) = 15 / 3 = 0
    either (neq (rem (add 10 5) (sub 8 5)) 0) [4][
    0
    ]]]]
]

(print_i32 (test_nested 0))